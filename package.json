{
	"name": "blog-personal-fluxdev",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"dev:full": "bun run build && bunx wrangler pages dev dist/ --ip localhost --port 4321",
		"build": "astro build && pagefind --site dist",
		"preview": "astro preview",
		"astro": "astro",
		"sync:db": "wrangler d1 export blog-comments --remote --output=./.wrangler/db.sql && wrangler d1 execute blog-comments --local --file=./.wrangler/db.sql",
		"check": "biome check . --write",
		"lint": "biome lint .",
		"format": "biome format . --write",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/react": "^6.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource/outfit": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.2",
		"hono": "^4.13.7",
		"mdast-util-to-string": "^4.0.0",
		"pagefind": "^1.5.2",
		"reading-time": "^1.5.0",
		"sanitize-html": "^2.17.7",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.2",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@cloudflare/workers-types": "^5.20260911.1",
		"@iconify/json": "^2.2.527",
		"@iconify/tailwind4": "^1.2.3",
		"@tailwindcss/typography": "^0.5.20",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.1",
		"jsdom": "^30.0.1",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.1"
	}
}
